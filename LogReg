    for strat_name, strat_df in strata.items():
        if method == "unadj":
            results.loc[row_name, strat_name] = run_unadjusted(strat_df, outcome)
        else:  # adj_bal
            results.loc[row_name, strat_name] = run_adjusted_balanced(strat_df, outcome)
 
