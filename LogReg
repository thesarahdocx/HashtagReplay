}
 
# ----------------------------------------------------------------------
# 2. HELPER FUNCTIONS
# ----------------------------------------------------------------------
 
def fit_logit(data: pd.DataFrame, outcome: str, predictors: list):
    """Fit a logistic regression and return a formatted OR (95% CI), p-value string."""
    model_df = data[[outcome] + predictors].dropna()
 
    if model_df[outcome].nunique() < 2:
        return "NA (no outcome variation)"
 
    X = sm.add_constant(model_df[predictors].astype(float))
    y = model_df[outcome].astype(float)
 
    try:
        result = sm.Logit(y, X).fit(disp=0)
    except Exception as e:
        return f"NA (model failed: {e})"
 
    params = result.params
    conf = result.conf_int()
    pvals = result.pvalues
 
    or_val = np.exp(params[EXPOSURE])
    ci_low, ci_high = np.exp(conf.loc[EXPOSURE])
    p_val = pvals[EXPOSURE]
 
    return f"OR={or_val:.2f} (95% CI: {ci_low:.2f}-{ci_high:.2f}), p={p_val:.3f}, n={len(model_df)}"
 
#Majority class undersampling for dataframe balance

def balance_majority_undersample(data: pd.DataFrame, outcome: str, predictors: list):
    """Random majority-class undersampling on `outcome`, returns a balanced dataframe."""
    model_df = data[[outcome] + predictors].dropna()
 
    X = model_df[predictors]
    y = model_df[outcome]
 
    rus = RandomUnderSampler(sampling_strategy="auto", random_state=RANDOM_STATE)
    X_res, y_res = rus.fit_resample(X, y)
 
    balanced = X_res.copy()
    balanced[outcome] = y_res.values
    return balanced
 
 
def run_unadjusted(data: pd.DataFrame, outcome: str):
    """Outcome ~ ADRD, no covariates, no balancing."""
    return fit_logit(data, outcome, [EXPOSURE])
 
 
def run_adjusted_balanced(data: pd.DataFrame, outcome: str):
    """Outcome ~ ADRD + covariates, fit on a majority-undersampled (balanced) dataset."""
    predictors = [EXPOSURE] + ADJUST_COVARIATES
    balanced_df = balance_majority_undersample(data, outcome, predictors)
    return fit_logit(balanced_df, outcome, predictors)
 
 
