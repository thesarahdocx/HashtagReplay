DATA_PATH = "your_data.csv"          # path to the analytic dataset
OUTCOMES = ["VARIABLE1", "VARIABLE2", "VARIABLE3"]       # binary outcome columns (0/1)
EXPOSURE = "ADRD"                    # exposure/predictor of interest (0/1)
 
# Covariates to include in the "adjusted" models (edit to your covariate set)
ADJUST_COVARIATES = [
    "Covariate1",
    "Covariate2",
    "Comorbidity_Index",
